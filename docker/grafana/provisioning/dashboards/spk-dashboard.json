{
  "title": "SPK SMKN 5 Jember - Monitoring",
  "uid": "spk-monitoring",
  "schemaVersion": 38,
  "version": 3,
  "refresh": "30s",
  "timezone": "Asia/Jakarta",
  "tags": [
    "spk",
    "smkn",
    "laravel",
    "mysql",
    "nginx",
    "php-fpm",
    "docker"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "panels": [
    {
      "id": 1,
      "title": "MySQL - Koneksi Aktif",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected",
          "legendFormat": "Connections",
          "datasource": "Prometheus"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "MySQL - Queries Per Second",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "rate(mysql_global_status_questions[1m])",
          "legendFormat": "QPS",
          "datasource": "Prometheus"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Nginx - Request Per Second",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "rate(nginx_http_requests_total[1m])",
          "legendFormat": "RPS",
          "datasource": "Prometheus"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Nginx - Koneksi Aktif",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "nginx_connections_active",
          "legendFormat": "Active",
          "datasource": "Prometheus"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "MySQL - Uptime",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "mysql_global_status_uptime",
          "legendFormat": "Uptime",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      }
    },
    {
      "id": 6,
      "title": "MySQL - Connections Over Time",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected",
          "legendFormat": "Connected",
          "datasource": "Prometheus"
        },
        {
          "expr": "mysql_global_status_threads_running",
          "legendFormat": "Running",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 7,
      "title": "Nginx - Request Rate Over Time",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(nginx_http_requests_total[5m])",
          "legendFormat": "Request/sec",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 8,
      "title": "MySQL - Slow Queries",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(mysql_global_status_slow_queries[5m])",
          "legendFormat": "Slow Queries/sec",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 9,
      "title": "Service Status",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "up{job=~\"mysql|nginx|php-fpm|prometheus\"}",
          "legendFormat": "{{job}}",
          "datasource": "Prometheus"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "PHP-FPM - Active Processes",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "phpfpm_active_processes",
          "legendFormat": "Active",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 11,
      "title": "PHP-FPM - Idle Processes",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 24,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "phpfpm_idle_processes",
          "legendFormat": "Idle",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 12,
      "title": "PHP-FPM - Total Processes",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "phpfpm_total_processes",
          "legendFormat": "Total",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 13,
      "title": "PHP-FPM - Requests/sec",
      "type": "timeseries",
      "gridPos": {
        "x": 18,
        "y": 24,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "rate(phpfpm_accepted_connections[1m])",
          "legendFormat": "Req/sec",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 14,
      "title": "PHP-FPM - Process Activity",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "phpfpm_active_processes",
          "legendFormat": "Active",
          "datasource": "Prometheus"
        },
        {
          "expr": "phpfpm_idle_processes",
          "legendFormat": "Idle",
          "datasource": "Prometheus"
        },
        {
          "expr": "phpfpm_total_processes",
          "legendFormat": "Total",
          "datasource": "Prometheus"
        }
      ]
    }
  ]
}
