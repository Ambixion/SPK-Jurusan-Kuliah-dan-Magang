{
  "title": "SPK SMKN 5 Jember - Monitoring",
  "uid": "spk-monitoring",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "MySQL - Koneksi Aktif",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected",
          "datasource": "Prometheus",
          "legendFormat": "Koneksi"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "MySQL - Queries Per Second",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "rate(mysql_global_status_queries[1m])",
          "datasource": "Prometheus",
          "legendFormat": "QPS"
        }
      ]
    },
    {
    "builder": {
        "gc": true,
        "default": true
    },
    "dns": [
        "8.8.8.8",
        "8.8.4.4"
    ]
    },
    {
      "id": 3,
      "title": "Nginx - Request Per Second",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "rate(nginx_http_requests_total[1m])",
          "datasource": "Prometheus",
          "legendFormat": "RPS"
        }
      ]
    },
    {
      "id": 4,
      "title": "Nginx - Koneksi Aktif",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "nginx_connections_active",
          "datasource": "Prometheus",
          "legendFormat": "Active"
        }
      ]
    },
    {
      "id": 5,
      "title": "MySQL - Uptime (detik)",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 4, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "mysql_global_status_uptime",
          "datasource": "Prometheus",
          "legendFormat": "Uptime"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 300 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "MySQL - Koneksi Over Time",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 4, "w": 16, "h": 6 },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected",
          "datasource": "Prometheus",
          "legendFormat": "Threads Connected"
        },
        {
          "expr": "mysql_global_status_threads_running",
          "datasource": "Prometheus",
          "legendFormat": "Threads Running"
        }
      ]
    },
    {
      "id": 7,
      "title": "Nginx - Request Rate Over Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 10, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "rate(nginx_http_requests_total[5m])",
          "datasource": "Prometheus",
          "legendFormat": "Request/s (5m avg)"
        }
      ]
    },
    {
      "id": 8,
      "title": "MySQL - Slow Queries",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "rate(mysql_global_status_slow_queries[5m])",
          "datasource": "Prometheus",
          "legendFormat": "Slow Queries/s"
        }
      ]
    },
    {
      "id": 9,
      "title": "Prometheus - Up Status",
      "type": "stat",
      "gridPos": { "x": 12, "y": 18, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "up",
          "datasource": "Prometheus",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "Asia/Jakarta",
  "tags": ["spk", "smkn", "laravel", "mysql", "nginx"]
}
